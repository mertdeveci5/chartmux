{
  "$schema": "https://chartmux.dev/schema/v1.json",
  "version": 1,
  "type": "combo",
  "title": "Lovable: revenue and growth between disclosures",
  "description": "Bars: ARR / run rate ($M) · Line: increase vs previous disclosure (%) · Shared numeric scale",
  "footer": "Growth = (current / previous - 1) × 100. Disclosure intervals vary, so this is not monthly or annual growth.",
  "xAxis": {
    "dataKey": "date",
    "kind": "category"
  },
  "series": [
    {
      "dataKey": "runRate",
      "label": "ARR / run rate ($M)",
      "color": "#ff6b7a",
      "mark": "bar"
    },
    {
      "dataKey": "growth",
      "label": "Growth vs prior disclosure (%)",
      "color": "#4dd6e8",
      "mark": "line"
    }
  ],
  "legend": {
    "show": true
  },
  "axes": {
    "show": true
  },
  "labels": {
    "show": true
  },
