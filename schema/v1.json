{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chartmux.dev/schema/v1.json",
  "title": "Chartmux chart",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "type", "data", "series"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "type": {
      "enum": ["bar", "line", "area", "combo", "scatter", "histogram", "pie", "donut", "heatmap", "radar", "funnel"]
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "footer": { "type": "string" },
    "data": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "type": "object" }
    },
    "xAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataKey"],
      "properties": {
        "dataKey": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["category", "number", "time"] }
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataKey"],
        "properties": {
          "dataKey": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "color": { "type": "string" },
          "mark": { "enum": ["bar", "line"] }
        }
      }
    },
    "layout": { "enum": ["grouped", "overlay", "stacked", "normalized"] },
    "orientation": { "enum": ["vertical", "horizontal"] },
    "curve": { "enum": ["linear", "smooth"] },
    "legend": { "$ref": "#/$defs/display" },
    "axes": { "$ref": "#/$defs/display" },
    "labels": { "$ref": "#/$defs/display" },
    "theme": { "enum": ["light", "dark"] },
    "bins": { "type": "integer", "minimum": 1, "maximum": 100 },
    "max": { "type": "number", "exclusiveMinimum": 0 }
  },
  "$defs": {
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["show"],
      "properties": {
        "show": { "type": "boolean" }
      }
    }
  }
}
