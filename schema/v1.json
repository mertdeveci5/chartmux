{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chartmux.dev/schema/v1.json",
  "title": "Chartmux chart",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "type", "data", "series"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "type": {
      "enum": ["bar", "line", "area", "combo", "scatter", "histogram", "pie", "donut", "heatmap", "radar", "funnel"]
    },
    "title": { "type": "string", "maxLength": 240 },
    "description": { "type": "string", "maxLength": 2000 },
    "footer": { "type": "string", "maxLength": 2000 },
    "data": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "type": "object" }
    },
    "xAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataKey"],
      "properties": {
        "dataKey": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\u0000-\u001F\u007F-\u009F]+$" },
        "kind": { "enum": ["category", "number", "time"] }
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataKey"],
        "properties": {
          "dataKey": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\u0000-\u001F\u007F-\u009F]+$" },
          "label": { "type": "string", "maxLength": 120, "pattern": "^[^\u0000-\u001F\u007F-\u009F]*$" },
          "color": { "type": "string", "pattern": "^(#[0-9A-Fa-f]{6}|var\\(--chart-[1-6]\\))$" },
          "mark": { "enum": ["bar", "line"] }
        }
      }
    },
    "layout": { "enum": ["grouped", "overlay", "stacked", "normalized"] },
    "orientation": { "enum": ["vertical", "horizontal"] },
    "curve": { "enum": ["linear", "smooth"] },
    "legend": { "$ref": "#/$defs/display" },
    "axes": { "$ref": "#/$defs/display" },
    "labels": { "$ref": "#/$defs/display" },
    "theme": { "enum": ["light", "dark"] },
    "bins": { "type": "integer", "minimum": 0, "maximum": 100 },
    "max": { "type": "number", "minimum": 0 },
    "annotations": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/annotation" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "not": { "const": "histogram" } } } },
      "then": { "required": ["xAxis"] }
    },
    {
      "if": { "properties": { "type": { "const": "area" } } },
      "then": { "properties": { "layout": { "enum": ["overlay", "stacked", "normalized"] } } },
      "else": {
        "if": { "properties": { "type": { "enum": ["bar", "histogram"] } } },
        "then": { "properties": { "layout": { "enum": ["grouped", "stacked", "normalized"] } } },
        "else": { "properties": { "layout": false } }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["bar", "histogram"] } } },
      "else": { "properties": { "orientation": false } }
    },
    {
      "if": { "properties": { "type": { "enum": ["line", "area"] } } },
      "else": { "properties": { "curve": false } }
    },
    {
      "if": { "properties": { "type": { "const": "histogram" } } },
      "then": { "properties": { "annotations": { "items": { "properties": { "dataIndex": false } } } } },
      "else": { "properties": { "bins": false } }
    },
    {
      "if": { "properties": { "type": { "const": "radar" } } },
      "then": { "properties": { "data": { "minItems": 3 } } },
      "else": { "properties": { "max": false } }
    },
    {
      "if": { "properties": { "type": { "const": "combo" } } },
      "then": { "properties": { "series": { "items": { "required": ["mark"] } } } },
      "else": { "properties": { "series": { "items": { "properties": { "mark": false } } } } }
    },
    {
      "if": { "properties": { "type": { "enum": ["histogram", "pie", "donut", "funnel"] } } },
      "then": { "properties": { "series": { "maxItems": 1 } } }
    },
    {
      "if": { "properties": { "type": { "const": "scatter" } } },
      "then": { "properties": { "xAxis": { "properties": { "kind": { "const": "number" } } } } }
    }
  ],
  "$defs": {
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "position": { "enum": ["top", "bottom"] },
        "dataIndex": { "type": "integer", "minimum": 0 },
        "series": { "type": "string", "minLength": 1 },
        "color": { "type": "string", "pattern": "^(#[0-9A-Fa-f]{6}|var\\(--chart-[1-6]\\))$" }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["show"],
      "properties": {
        "show": { "type": "boolean" }
      }
    }
  }
}
